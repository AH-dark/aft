{
  "args": {
    "callgraph": true,
    "context_lines": 2,
    "targets": [
      {
        "file": "<PROJECT_ROOT>/src/main.ts",
        "symbols": [
          "run",
          "missing"
        ],
        "target_label": "src/main.ts"
      },
      {
        "file": "https://example.test/docs",
        "symbol": "Overview",
        "target_label": "https://example.test/docs"
      }
    ]
  },
  "command": "zoom"
}
