    }
  },
  "workload": {
    "roots": [1, 5, 15],
    "source_file": "views_perf_probe.rs",
    "states": ["atomic_edit", "revert", "tool_write", "tool_revert", "branch_switch", "branch_return", "worktree_create", "worktree_remove"],
    "g2_warmup_minutes": 5,
    "g2_activity_minutes": 30,
    "g2_quiet_minutes": 20,
    "edit_cycle_seconds": 20,
    "query_interval_seconds": 5,
    "semantic_backend": "fastembed",
    "semantic_model": "default resolved by the binary; record effective model in each result",
    "witness": "probe_entry must call probe_alpha in base state and probe_beta in changed state; every state must be witnessed before another mutation"
  }
}
