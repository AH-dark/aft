{
  "schema": 1,
  "corpora": {
    "aft": {
      "repository": "https://github.com/cortexkit/aft.git",
      "commit": "05d40ac417db6137a4204521bd3c59853325e968"
    },
    "opencode": {
      "repository": "https://github.com/anomalyco/opencode.git",
      "commit": "f7d5a1cbc725665586dc69b312c11be1d3787f0b"
    },
    "kubernetes": {
      "repository": "https://github.com/kubernetes/kubernetes.git",
